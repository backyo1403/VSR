{
  "rules": {
    "rooms": {
      "$room": {

        "admin": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'admin@vna-sky-race.local'"
        },

        "progress": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'admin@vna-sky-race.local'"
        },

        "profiles": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'admin@vna-sky-race.local')",
            ".validate": "newData.hasChildren(['name','avatar']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 18"
          }
        },

        "//boosts": "Turbo Boost announcements for the presenter wall. The answers tree is admin-read-only, so the wall could never see a boost being armed; this node carries ONLY a display name and a timestamp — never a choice — so it is safe for every signed-in client to read. Self-write per uid, plus admin for the reset wipe.",
        "boosts": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'admin@vna-sky-race.local'",
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "!newData.exists() || (newData.hasChildren(['name','at']) && newData.child('name').isString() && newData.child('name').val().length <= 18 && newData.child('at').isNumber())"
            }
          }
        },

        "answers": {
          ".read": "auth != null && auth.token.email == 'admin@vna-sky-race.local'",
          "$q": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",

              ".write": "auth != null && auth.uid == $uid && !data.child('submitted').val() && root.child('rooms/' + $room + '/admin/gameState').val() == 'question' && (!root.child('rooms/' + $room + '/admin/deadline').exists() || now < root.child('rooms/' + $room + '/admin/deadline').val())",

              ".validate": "newData.hasChildren(['choice']) && newData.child('choice').isNumber() && newData.child('choice').val() >= 0 && newData.child('choice').val() <= 3"
            }
          }
        }

      }
    }
  }
}
