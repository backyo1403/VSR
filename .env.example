# Copy this file to .env.local for local development, or set the same two
# variables in the Vercel dashboard (Project Settings -> Environment Variables)
# for production. Both are required — scripts/build-config.mjs fails the
# build loudly if either is missing, rather than shipping a broken client.
#
# Find these under Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the publishable/anon key — safe to expose in
# client code by design (Row Level Security is what actually protects data,
# not hiding this key). Never put the service_role key here or anywhere in
# this repo.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
